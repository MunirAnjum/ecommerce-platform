{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },

      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        }
      },

      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/Inventory/{**catch-all}"
        }
      },

      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/Payment/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://auth-service:8080/"
          }
        }
      },

      "product-cluster": {
        "Destinations": {
          "product-service": {
            "Address": "http://product-service:8080/"
          }
        }
      },

      "order-cluster": {
        "Destinations": {
          "order-service": {
            "Address": "http://order-service:8080/"
          }
        }
      },

      "inventory-cluster": {
        "Destinations": {
          "inventory-service": {
            "Address": "http://inventory-service:8080/"
          }
        }
      },

      "payment-cluster": {
        "Destinations": {
          "payment-service": {
            "Address": "http://payment-service:8080/"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}