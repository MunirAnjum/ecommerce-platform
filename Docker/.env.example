# -----------------------------------------------------------------------------
# Karakoram Harvest E-Commerce Platform - Docker Environment Template
# Copy this file to .env and replace placeholder values with your actual secrets.
# NEVER commit real credentials to version control.
# -----------------------------------------------------------------------------

# Notification Service (SMTP)
EMAIL_FROM=notifications@karakoramharvest.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# Inter-Service Authentication Keys (Base64 or GUID)
PAYMENT_SERVICE_KEY=YOUR_PAYMENT_SERVICE_KEY_BASE64
ORDER_SERVICE_KEY=YOUR_ORDER_SERVICE_KEY_BASE64
PRODUCT_SERVICE_KEY=YOUR_PRODUCT_SERVICE_KEY_GUID
INVENTORY_SERVICE_KEY=YOUR_INVENTORY_SERVICE_KEY_GUID

# JWT Authentication
JWT_KEY=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARACTERS

# Seed Admin Account
ADMIN_EMAIL=admin@karakoramharvest.local
ADMIN_PASSWORD=Admin123!

# Cloudinary Image Storage & CDN
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
